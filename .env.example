OPENAI_API_KEY=sk-...
PADDLE_OCR_URL=http://localhost:8051
TESSERACT_URL=http://localhost:8052
OCR_ENGINE=paddleocr
MAX_PAGE_WORKERS=4
DPI=300
# OCR language for PaddleOCR: en (Latin/Spanish), ru (Russian/Cyrillic), ch (Chinese+English)
OCR_LANG=en

# Per-script TTF font paths (optional).
# When set, these files are used directly — no internet download needed.
# NotoSans-Regular.ttf covers both Latin and Cyrillic scripts.
# Download it from: https://fonts.google.com/noto/specimen/Noto+Sans
#
# FONT_LATIN=/path/to/NotoSans-Regular.ttf
# FONT_CYRILLIC=/path/to/NotoSans-Regular.ttf
# FONT_ARABIC=/path/to/NotoSansArabic-Regular.ttf
# FONT_HEBREW=/path/to/NotoSansHebrew-Regular.ttf
# FONT_DEVANAGARI=/path/to/NotoSansDevanagari-Regular.ttf
# FONT_THAI=/path/to/NotoSansThai-Regular.ttf
# FONT_KOREAN=/path/to/NotoSansKR-Regular.ttf
# FONT_CJK=/path/to/NotoSansSC-Regular.ttf
